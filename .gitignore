# ============================================================
# CMP4501 – Autonomous Driving with Highway-Env
# .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
.env/
ENV/

# ── Distribution / packaging ──────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── PyInstaller ───────────────────────────────────────────────
*.spec

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDEs ──────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── OS artefacts ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Project-specific outputs (keep directory, ignore contents) ─
checkpoints/*.pt
checkpoints/*.zip
checkpoints/*.pkl
logs/*.log
logs/*.csv
logs/*.json
results/*.png
results/*.svg
results/*.json
results/*.csv
videos/*.mp4
videos/*.avi
videos/*.gif

# Keep the empty directories tracked by Git
!checkpoints/.gitkeep
!logs/.gitkeep
!results/.gitkeep
!videos/.gitkeep
!assets/.gitkeep

# Keep the verified final submission artifacts
!checkpoints/ppo_highway_20260605_110802_step_0.zip
!checkpoints/ppo_highway_20260605_110802_step_100000.zip
!checkpoints/ppo_highway_20260605_110802_step_200000.zip
!logs/train.log
!results/comparison_ppo_highway_20260605_110802.json
!videos/untrained_agent.mp4
!videos/half_trained_agent.mp4
!videos/fully_trained_agent.mp4

# ── Secrets / credentials ─────────────────────────────────────
.env
*.pem
*.key
secrets.yaml
secrets.json

# ── Coverage / testing ────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.tox/
coverage.xml
*.cover

# ── mypy / type checkers ──────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── Weights & Biases / MLflow artefacts ───────────────────────
wandb/
mlruns/
